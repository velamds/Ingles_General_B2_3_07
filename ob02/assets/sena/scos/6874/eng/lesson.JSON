{"_data": [{"type": "metadata", "contents": [{"content": "Too Many Cooks", "type": "lesson_name"}, {"content": "Cool as a Cucumber", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 7, "type": "lesson"}, {"content": "B2.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe emotions and feelings in present and past situations in spoken or written texts and in work and social contexts.", "type": "primary"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_2"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_3"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_4"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_5"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_6"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_7"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_8"}]}, {"content": "engenn11le07ob02re1img01.jpg", "type": "background_image"}, {"type": "target_word", "contents": [{"content": "to cut out", "type": "name"}, {"content": "to remove ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: If I cut out all those things, what do I eat?", "type": "example"}, {"content": "engenn11le07ob02aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about beliefs and opinions.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "dairy", "type": "name"}, {"content": "products containing or made from milk", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I removed all the sugar, fat, meat and dairy from my kitchen.", "type": "example"}, {"content": "engenn11le07ob02aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "spice", "type": "name"}, {"content": "an aromatic or pungent vegetable substance used to flavor food", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There's nothing left except a few spices.", "type": "example"}, {"content": "engenn11le07ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to live on", "type": "name"}, {"content": "to survive by doing something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: If I had to live on what's in the fridge now, I would waste away to nothing.", "type": "example"}, {"content": "engenn11le07ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to waste away", "type": "name"}, {"content": "to gradually become thin and weak", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: If you don't eat, you will waste away.", "type": "example"}, {"content": "engenn11le07ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to throw together", "type": "name"}, {"content": "to quickly assemble", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I can help you with some meals that you can throw together that don't have any of the ingredients that you are trying to avoid.", "type": "example"}, {"content": "engenn11le07ob02aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "vegan", "type": "name"}, {"content": "without the use of animal products", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: If there were more demand, I would open a small vegan restaurant.", "type": "example"}, {"content": "engenn11le07ob02aud07", "type": "audio"}]}, {"type": "learning_points", "contents": [{"content": " Other Ways of Talking about Result", "type": "heading"}, {"content": "You can talk about results or consequences of something by using a result clause in your sentences.", "type": "describer"}, {"content": "We were talking about the dangers of eating too much fat and sugar and, as a result, I've decided to do a cleanse.", "type": "example"}, {"content": "There are several ways you can express a result. The following ways all use the word \u201cresult\u201d in them, but they are used in different ways.<br /> With these expressions, you should first provide the situation or action that led to the result, and then say what the result was after the expression.", "type": "text"}, {"content": "{\"rows\":5,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Cause</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Result</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">There was a devastating earthquake in India yesterday </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\"><span class=\\\"strong\\\">and as a result</span>, thousands of people died.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">There was a devastating earthquake in India yesterday, </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><span class=\\\"strong\\\"> with the result that</span> thousands of people died.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">There was a devastating earthquake in India yesterday.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><span class=\\\"strong\\\"> As a result,</span> thousands of people died.</span><br /><br />  If you want to begin a new sentence about the result, you can also use:<br /> <span class=\\\"strong\\\"> Consequently<br />  Therefore<br />  Thus<br />  For this/that reason</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">There was a devastating earthquake in India yesterday, </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><span class=\\\"strong\\\"> resulting in</span>  the deaths of thousands of people. </span><br /> <br /> (Notice the use of the noun \u201cdeath\u201d here instead of the verb \u201cdied\u201d as in the other sentences.)\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "I removed all the sugar, fat, meat and dairy from my kitchen with the result that there's nothing left except a few spices.", "type": "example"}, {"content": "Therefore, I can help you with some meals.", "type": "example"}, {"content": "Long ago I worked in a vegan restaurant, resulting in the creation of lots of recipes that you can use.", "type": "example"}, {"content": "A couple people are away this weekend and, as a result, I'm working all weekend.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " Unlikely Conditional", "type": "heading"}, {"content": "You can use conditional sentences to talk about events or situations that are unreal in the present and unlikely in the future.", "type": "describer"}, {"content": "If I had to live on what's in the fridge now, I would waste away to nothing.", "type": "example"}, {"content": "Depending on the context, you can express conditions that are not real or impossible in the present and not likely to happen in the future. <br /> Since these situations are not real, you have to remember the truth of the situation to use the opposite form of the verb.", "type": "text"}, {"content": "<span class=\"italic\"><span class=\"strong\">If I liked</span>  dogs, I <span class=\"strong\">would have</span>  a dog as a pet. <br />  <span class=\"strong\">I would have</span> a dog as a pet <span class=\"strong\">if I liked</span>  dogs. </span></span>  <br />  (the truth in the present: I don't like dogs. I don't have a dog as a pet.)", "type": "text"}, {"content": "<span class=\"italic\"><span class=\"strong\">If </span> the president<span class=\"strong\"> weren't</span> so handsome, many women <span class=\"strong\">would not watch</span> the news. <br />  Many women<span class=\"strong\"> would not watch</span> the news<span class=\"strong\"> if</span> the president <span class=\"strong\">weren't</span> so handsome. <br /> </span> (the truth in the present: The president is handsome. Many women watch the news.)", "type": "text"}, {"content": "<span class=\"italic\"><span class=\"strong\">If I won</span> a million dollars, <span class=\"strong\"> I would travel</span> around the world. <br />  <span class=\"strong\">I would travel</span> around the world<span class=\"strong\"> if I won</span> a million dollars.</span> <br />  (I think it is unlikely in the future that I will win a million dollars and travel around the world.)", "type": "text"}, {"content": "The structure for this second conditional is: <br />   <span class=\"strong\">If + simple past, would + base form of verb<br />  \u2026would + base form of verb + if + simple past</span>", "type": "text"}, {"content": "If there were more demand, I would open a small vegan restaurant.", "type": "example"}, {"content": "If I could cook, I would open my own restaurant.", "type": "example"}, {"content": "If I weren't so busy, I'd come and cook with you.", "type": "example"}, {"content": "If I lost some weight, it would probably make her happy! ", "type": "example"}]}, {"type": "takeaway_extension", "contents": [{"content": "Imagine that a vegan friend is coming to your house for dinner.", "type": "text"}, {"content": "Plan a menu of at least 3 dishes that your friend can eat.", "type": "text"}, {"content": "Write a list of all the ingredients. Look up any ingredients that you don't know in your dictionary.", "type": "text"}, {"content": "Exchange your menu with another student and discuss which menu sounds more delicious.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I plan a menu for a vegan dinner.", "type": "text"}, {"content": "I make a list of vegan ingredients.", "type": "text"}, {"content": "I look up ingredients that I don't know in the dictionary.", "type": "text"}, {"content": "I exchange menus with a partner and discuss which menu is more delicious.", "type": "text"}]}], "labs": [{"exercises": [{"template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": "I can talk about beliefs and opinions and use colloquial expressions.", "type": "Learning Outcomes"}, {"content": "I can talk about the results of an action or an event.", "type": "Learning Outcomes"}, {"content": "I can write about unlikely or impossible situations in the present or in the future.", "type": "Learning Outcomes"}, {"content": "What foods could you cut out of your diet to make it healthier?", "type": "Free Header Item"}, {"content": "How difficult is it for you to make changes to your diet?", "type": "Free Header Item"}]}, {"type": "group", "contents": [{"content": "Welcome", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}]}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": " Making a big change!", "type": "free_type_text_area"}], "img_path": "", "questions": [], "type": "WLC", "id": 0, "stimuli_ids": [0]}, {"template_override": 1, "type": "STI", "questions": [{"responses": [{"correct": 0, "_da
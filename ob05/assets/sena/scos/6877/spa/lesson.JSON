{"type": "sena", "_data": [{"contents": [{"type": "lesson_name", "content": "Too Many Cooks"}, {"type": "unit_name", "content": "A Bad Apple"}, {"type": "position", "content": 5}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 7}, {"type": "level", "content": "B2.3"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Describe emotions and feelings in present and past situations in spoken or written texts and in work and social contexts."}, {"type": "secondary_1", "content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_2", "content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_3", "content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_4", "content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_5", "content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_6", "content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_7", "content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_8", "content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}], "type": "objectives"}, {"type": "background_image", "content": "engenn11le07ob05re1img01.jpg"}, {"contents": [{"type": "name", "content": "motivated"}, {"type": "definition", "content": "interested in or enthusiastic about doing something"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You have to be motivated and dedicated to make this sacrifice."}, {"type": "audio", "content": "engenn11le07ob05aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": " These are words you use to talk about people's personalities."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "commendable"}, {"type": "definition", "content": "deserving of praise"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I think it's really commendable that you are doing this, Peter."}, {"type": "audio", "content": "engenn11le07ob05aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "dedicated"}, {"type": "definition", "content": "devoted to a task or purpose"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You have to be dedicated to change your habits."}, {"type": "audio", "content": "engenn11le07ob05aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "sacrifice"}, {"type": "definition", "content": "something that you give up something for something \u200belse \u200bconsidered more \u200bimportant"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Giving up dairy is a big sacrifice for me."}, {"type": "audio", "content": "engenn11le07ob05aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "strong-willed"}, {"type": "definition", "content": "determined to do as one wants "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She's not as strong-willed as I am when it comes to sugar. "}, {"type": "audio", "content": "engenn11le07ob05aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "gung ho"}, {"type": "definition", "content": "unthinkingly enthusiastic and eager"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I feel more gung ho now."}, {"type": "audio", "content": "engenn11le07ob05aud06"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to cheat"}, {"type": "definition", "content": "to \u200bbehave in a dishonest way or \u200bdeceive someone in \u200border to get what you want"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: If she really needed one, she could have a cheat day."}, {"type": "audio", "content": "engenn11le07ob05aud08"}], "type": "target_word"}, {"contents": [{"type": "heading", "content": " Reporting Questions"}, {"type": "describer", "content": "You can report things people say as well as questions people ask. If you want to report questions in your own words, there are some differences in the sentence structure."}, {"type": "example", "content": "She asked if we could make sure we get some dessert recipes too. "}, {"type": "text", "content": "You may use and ask different questions on a daily basis. There are wh-questions and yes/ no questions.  "}, {"type": "text", "content": "If you want to report an information or wh-question, you can simply use the reporting clause with the wh-word."}, {"type": "text", "content": "<span class=\"italic\">What is your name? &rarr;The teacher asked me <span class=\"strong\">what </span>my name was. </span><br />  <span class=\"italic\">Where do you live? &rarr;The teacher asked me<span class=\"strong\"> where</span> I lived. </span><br />  <span class=\"italic\">When do you want to have lunch? &rarr;My mother asked me<span class=\"strong\"> when</span> I wanted to have lunch. </span>"}, {"type": "text", "content": "When you are reporting yes/ no questions, you need to add <span class=\"strong\">if</span>  or <span class=\"strong\">whether</span> . Remember that only whether can be followed by a to-infinitive."}, {"type": "text", "content": "<span class=\"italic\"><span class=\"strong\">Fernanda</span> : \u201cDo you want to work at the hospital?\u201d </span><br />  Fernanda asked <span class=\"strong\">whether</span>  I wanted to work at the hospital. </span><br /><br />   <span class=\"strong\">Luis</span> : \u201cWill you be at the mall later?\u201d </span><br /> Luis asked<span class=\"strong\"> if/ whether</span>  I would be at the mall later. </span>"}, {"type": "text", "content": "Did you notice the word order when you were reporting what people asked?  The common word order for reporting with wh- or if/whether-clauses is like that of a statement."}, {"type": "text", "content": "<span class=\"italic\">My mother asked me <span class=\"strong\">when I wanted to have lunch. </span><br /> Luis asked <span class=\"strong\">if/ whether I would be at the mall later. </span>"}, {"type": "text", "content": "Questions with \u2018Be':"}, {"type": "text", "content": "<span class=\"italic\">Who is your favourite singer? <br />  The stranger asked me<span class=\"strong\"> who my favourite singer was. </span><br />  OR<br />  The stranger asked me<span class=\"strong\"> who was my favourite singer. </span><br /><br />   <span class=\"italic\">What are the CDs used for? <br />  My friend asked me<span class=\"strong\"> what the CDs were used for. </span><br />  OR <br /> My friend asked me<span class=\"strong\"> what were the CDs used for. </span></span>"}, {"type": "text", "content": "In questions that begin with what, which or who and be with a complement, you can put the complement before or after the \u2018be' verb form."}, {"type": "text", "content": "Questions with \u2018Do':"}, {"type": "text", "content": "<span class=\"italic\">When do you want to have lunch? <br /> My mother asked me <span class=\"strong\">when I wanted to have lunch</span><br /><br /> <span class=\"strong\"> Fernanda </span>: \u201cDo you want to work at the hospital?\u201d <br /> Fernanda asked <span class=\"strong\">whether I wanted to work at the hospital. </span><br /> <br /> What did you study in university? <br /> She asked <span class=\"strong\">what I had studied in university. </span><br /><br /> Did you like the movie? <br /> She asked<span class=\"strong\"> if/ whether I liked the movie. </span><br /> <br /> Why don't you like the actors? <br /> She asked<span class=\"strong\"> why I didn't like actors. </span></span>"}, {"type": "text", "content": "What happens to \u2018do' in the above examples?"}, {"type": "text", "content": "You don't use \u2018do' in the wh- or if/whether-clauses. If the question is negative, however, you can use \u2018do' in the negative."}, {"type": "example", "content": "She also asked whether she could have honey."}, {"type": "example", "content": "She asked why I was doing it."}, {"type": "example", "content": "She wondered if it was possible to have a cheat day."}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": " Unlikely Conditionals: The Main Clause"}, {"type": "describer", "content": "You can use the second conditional to talk about events that are unlikely to happen in the future or impossible in the present."}, {"type": "example", "content": "If I could take the whole week off, I would be able to teach you everything I know. "}, {"type": "text", "content": "You can use this unlikely conditional with <span class=\"strong\">would </span> in the main clause."}, {"type": "text", "content": "<span class=\"strong\">If + simple past, \u2026would + base form of verb</span>"}, {"type": "text", "content": "Sometimes <span class=\"strong\">would</span> is shorted to \u2018<span class=\"strong\">d</span>.<br /> <span class=\"italic\">\t<span class=\"strong\">If</span> James <span class=\"strong\"> didn't smoke </span> , he <span class=\"strong\"> would be </span>healthier. <br /> \t<span class=\"strong\">If</span> James <span class=\"strong\"> didn't smoke </span> , he\u2018<span class=\"strong\">'d be</span> healthier. </span>"}, {"type": "text", "content": "You can also use other modals like could or might in the main clause. Could means \u201cwould be able to\u201d and might means that something is possible but unlikely to happen."}, {"type": "text", "content": "<span class=\"italic\">If I had a printer, I<span class=\"strong\"> could print</span> all my research papers from home. <br /> I<span class=\"strong\"> could buy</span> a car if I got a raise. <br /><br /> If I spoke Spanish, I<span class=\"strong\"> might travel</span> to South America. <br /> He<span class=\"strong\"> might understand</span> the grammar better if he came to school everyday. </span>"}, {"type": "example", "content": "If it were easy, we would all have great eating habits and very healthy diets."}, {"type": "example", "content": "If she could do it with you, it would make it easier for you to stay on track."}, {"type": "example", "content": "If she really needed one, she could have a cheat day. "}, {"type": "example", "content": "If she were at a birthday party and everyone was having cake, she could have a small piece."}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "go cold turkey "}, {"type": "definition", "content": "to abruptly and completely stop something"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: You don't have to go cold turkey on sugar."}, {"type": "audio", "content": "engenn11le07ob05aud09"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "Watch the TEDMED Talk: Why do our brains get addicted? (Nora Volkow)."}, {"type": "text", "content": "Take notes while you watch. Watch as many times as you need."}, {"type": "text", "content": "If possible, compare notes with a partner who watched the same video."}, {"type": "text", "content": "Look up any new vocabulary."}, {"type": "text", "content": "Write a paragraph that summarizes what you heard and explains whether or not you agree with the speaker."}, {"type": "text", "content": "Read your paragraph to your class or group."}], "type": "takeaway_extension"}, {"contents": [{"type": "text", "content": "I watch and listen to a TEDMED Talk."}, {"type": "text", "content": "I make notes while I listen."}, {"type": "text", "content": "I look up new vocabulary."}, {"type": "text", "content": "I write a paragraph to summarize what I heard."}, {"type": "text", "content": "I read my paragraph to a group."}], "type": "takeaway_assessment"}], "labs": [{"exercises": [{"questions": [], "img_path": "", "stimuli_ids": [0], "template_override": 1, "type": "WLC", "_data": [{"contents": [{"type": "Learning Outcomes", "content": " I can talk about people's personalities and use colloquial expressions."}, {"type": "Learning Outcomes", "cont
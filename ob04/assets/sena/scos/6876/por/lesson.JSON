: 0}]}], "stimuli_ids": [], "template_override": 1, "type": "DWS", "_data": [{"contents": [{"type": "text", "content": " \nMake sentences with homographs.\n"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}, {"contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}], "type": "post_instructions"}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}], "id": 11}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "stimuli": [{"contents": [{}], "type": "welcome", "_data": [], "id": 0, "template_override": 1}, {"contents": [{"type": "slideshow", "value": {"images": [{"time": "0", "text": "", "id": 0, "image": "engenn11le07ob04re2img05.jpg"}, {"time": "100", "text": "<span class=\"strong\"> Peter</span>: \t\tHello? Hold on just a second \u2026 I'm paying for my java \u2026 Okay, hi Vanessa. <br />\n<span class=\"strong\"> Vanessa</span>: \tHi Peter. Did you talk to Amy a second time? Does she still want to give you a hand with your cleanse and preparing your meals? <br />\n<span class=\"strong\"> Peter </span>: \t\tYeah, she does. She's coming by this weekend to look at the recipes and the cookbook and make a shopping list. We might still need your help with some of the recipes. Will you be able to take a call while you're at work? <br />\n<span class=\"strong\"> Vanessa</span>: \tI have an even better idea. The staff person who needed the weekend off had to change her plans so I'm free for the whole weekend and I don't have to close the restaurant on Friday. <br />\n<span class=\"strong\"> Peter</span>: \t\tWow, that's great! You can relax and not think about cooking, except for when we call you for advice. <br />", "id": 1, "image": "engenn11le07ob04re2img05.jpg"}, {"time": "43000", "text": "<span class=\"strong\"> Vanessa</span>: \tWell, what do you think about this idea? I will teach you and Amy to cook this weekend. Amy's close to me and I know she's got a great kitchen with all the equipment and tools we need. We can spend the weekend at her place cooking together. I haven't been able to spend much time with either of you so we can take this time to catch up and also get you some new and improved eating habits. Also, we can use my car to carry all the heavy cans. You just need to bring change for the parking meter so I don't get a fine.", "id": 2, "image": "engenn11le07ob04re2img01.jpg"}, {"time": "75000", "text": "<span class=\"strong\"> Peter</span>: \t\tAre you sure? That would be great. Wait, what cans? <br />\n<span class=\"strong\"> Vanessa</span>: \tBeans, Peter. You're going to be getting your protein from beans. You can't have meat or dairy, remember? <br />\n<span class=\"strong\"> Peter</span>: \t\tOh right. Hmmm. Maybe I shouldn't have asked Amy to help me. <br />\n<span class=\"strong\"> Vanessa</span>: \tIt will be fine. I'm stoked! This is going to be a blast. And after a few days I promise you won't miss your coffee. Quitting will be a piece of cake. <br />\n<span class=\"strong\"> Peter</span>: \t\tI'll believe when I see it. I really appreciate your help Vanessa.", "id": 3, "image": "engenn11le07ob04re2img02.jpg"}], "audiosrc": "engenn11le07ob04re2aud01", "coverimg": "engenn11le07ob04re2img05.jpg"}}], "id": 1, "template_override": 1, "type": "audio", "title": "", "_data": []}], "id": 0}]}